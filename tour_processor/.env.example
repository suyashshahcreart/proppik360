# Worker API
WORKER_API_URL=http://127.0.0.1:8787
PROCESSOR_SECRET=dev-processor-secret-change-in-production

# R2 credentials (same values as tour_saas_platform/.dev.vars)
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=proppik360

# R2 public domain (after enabling public access in Cloudflare Dashboard)
# Cloudflare Dashboard → R2 → your bucket → Settings → Public R2.dev Bucket URL
R2_PUBLIC_DOMAIN=pub-abc123def456.r2.dev

# Server
PORT=9000

# Temp directory for downloaded ZIPs (must have free space = 2x largest ZIP).
# Orphaned *.zip and r2upload-*.tmp files here are deleted automatically on processor startup.
TEMP_DIR=D:\Extra\proppik360\data\temp

# Performance tuning
# Max tours processed at the same time — extras wait in a queue.
# On a shared VPS keep this modest (2–3) so other apps keep headroom.
MAX_CONCURRENT_JOBS=5

# ── R2 publish concurrency (global across all tours) ─────────────────────
# mode=adaptive (default): AIMD climbs/drops between MIN and MAX using live
#   files/sec + error rate. Also capped by RESOURCE_BUDGET_PERCENT × CPU cores.
# mode=fixed: pin exactly to MAX_GLOBAL_UPLOAD_CONCURRENCY (legacy behaviour).
UPLOAD_CONCURRENCY_MODE=adaptive
#
# Optional machine preset: local | kvm4 | kvm8
# MACHINE_PROFILE=kvm8
#
# Leave ~30% for other apps on shared VPS (processor targets ~70%).
RESOURCE_BUDGET_PERCENT=70
#
# Adaptive range (KVM 8–oriented defaults). Local PROFILE lowers these.
UPLOAD_CONCURRENCY_MIN=100
UPLOAD_CONCURRENCY_MAX=800
UPLOAD_CONCURRENCY_START=350
UPLOAD_CONCURRENCY_HARD_MAX=1000
UPLOAD_CONCURRENCY_STEP=25
UPLOAD_CONCURRENCY_INTERVAL_SEC=3
#
# Legacy fixed cap / adaptive start fallback when START is unset.
MAX_GLOBAL_UPLOAD_CONCURRENCY=400

# Parallel HTTP Range chunks used to download each ZIP from R2.
# Set to 1 to disable ranged downloads and use a single stream.
DOWNLOAD_CONCURRENCY=8
# Max concurrent range-fetch requests across ALL tours' downloads combined.
MAX_GLOBAL_DOWNLOAD_CONCURRENCY=24
# Successful HEAD checks required before Go deletes the local ZIP.
BACKUP_VERIFY_ATTEMPTS=3
