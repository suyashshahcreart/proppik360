# ============================================================
# PropPik 360 — local / VPS configuration
# ============================================================
#
# Copy to .env in this folder (never commit .env):
#   copy .env.example .env
#
# Local dev (no Wrangler): npm run dev:api + npm run dev:frontend
# Cloudflare: R2 only (S3 keys below). DB is SQLite on D: (see SQLITE_PATH).
# VPS live: same .env shape; swap SQLITE_PATH for PostgreSQL later.
# ============================================================

# SQLite database file (default on D: drive)
SQLITE_PATH=D:/Extra/proppik360/data/platform.sqlite

PORT=8787


# ============================================================
# SECRETS — Set via: npx wrangler secret put <NAME>
# NEVER commit real values to source control.
# ============================================================

# R2 API token credentials for signing presigned upload URLs.
# Create these in the Cloudflare Dashboard:
#   R2 → Manage R2 API tokens → Create API token
#   Permissions: Object Read & Write on your bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# ============================================================
# VARS — Set in wrangler.jsonc [vars]
# Safe to commit since they are not secrets.
# ============================================================

# 'development' or 'production'
ENVIRONMENT=development

# Public URL of your deployed Worker (used for CORS and links)
APP_URL=http://localhost:8787

# Allowed origin for API CORS requests.
# Development: Vite dev server
# Production: your actual frontend domain (e.g. https://tours.yourdomain.com)
CORS_ORIGIN=http://localhost:5173

# Your Cloudflare Account ID.
# Found in the Cloudflare Dashboard sidebar under "Account ID".
R2_ACCOUNT_ID=92dbc57b592c572a4914b960cac80c7b

# Must match the R2 bucket name in wrangler.jsonc.
R2_BUCKET_NAME=proppik360

# Multipart upload part size in bytes.
# Default: 10 MiB. Minimum: 5 MiB (R2/S3 requirement, except last part).
# With 10 MiB parts, a 3 GB file uses ~290 parts (limit is 10,000).
PART_SIZE_BYTES=26214400

# How many parts upload simultaneously from the browser.
UPLOAD_CONCURRENCY=8

# How many times to retry a failed part upload before aborting.
MAX_RETRIES=3

# Public hostname for tour viewer links (no https:// prefix).
# Production: proppik360.com (R2 custom domain)
# Local dev fallback: your r2.dev public bucket hostname
R2_PUBLIC_DOMAIN=pub-97f4aa1642a4429982a8583c0cf894c0.r2.dev

# Same hostname for the React app (tour URL preview on Upload page). Keep in sync with R2_PUBLIC_DOMAIN.
VITE_R2_PUBLIC_DOMAIN=pub-97f4aa1642a4429982a8583c0cf894c0.r2.dev

# Go processor webhook (POST after ZIP multipart upload completes).
# Local: tour_processor listening on port 9000.
PROCESSOR_WEBHOOK_URL=http://127.0.0.1:9000/jobs

# Shared secret with tour_processor (also safe in wrangler.jsonc for local only).
PROCESSOR_SECRET=dev-processor-secret-change-in-production
